PORT=4000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/utracker

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ORDER_LINK_TTL_HOURS=24

# Origenes del front que pueden llamar a esta API. Separar con coma para
# permitir varios (local + produccion + previews de Vercel).
# El front llama directo, asi que un origen que falte acá queda bloqueado.
CORS_ORIGIN=http://localhost:5173

# Base publica del front, sin barra final. Alimenta los links de seguimiento
# que salen por WhatsApp. Si se omite, se usa CORS_ORIGIN.
FRONTEND_URL=http://localhost:5173

# --- Cloudflare R2 (imagenes) ---
# Opcional: sin esto la API arranca igual, solo se desactiva la subida.
# El token necesita permiso "Object Read & Write" sobre el bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL publica del bucket, sin barra final.
# Dominio propio, o el r2.dev que sale al activar "Public Development URL".
R2_PUBLIC_BASE_URL=
R2_MAX_UPLOAD_BYTES=5242880

# --- WhatsApp (notificaciones automaticas) ---
# Bot COMPARTIDO de uTracker: lo usan los negocios sin sesion propia.
# Un negocio puede tener la suya; se configura desde Superadmin -> Negocios.
# Sin esto el sistema arranca igual, solo se omiten las notificaciones.
#
# URL completa de envio, con la sesion incluida:
WHATSAPP_SEND_URL=https://api-ws-unify.rapi-almacen.shop/api/sessions/utracker-397554/send
WHATSAPP_API_KEY=
# Codigo de pais que se antepone a los numeros de 9 digitos. Por defecto 51.
WHATSAPP_COUNTRY_CODE=51
